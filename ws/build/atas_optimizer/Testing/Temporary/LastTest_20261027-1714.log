<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>ATAS MOO v2.0.0 — Painel de Monitoramento e Validação</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
