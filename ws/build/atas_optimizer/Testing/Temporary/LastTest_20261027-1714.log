        ctx.fillStyle = '#f59e0b';
        ctx.beginPath();
        ctx.arc(ux, uy, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = '10px monospace';
        ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
