          </tr>
        </thead>
        <tbody id="table-cbba"></tbody>
      </table>
    </div>
  </div>

  <div id="tab-3" class="tab-content" style="display: none;">
    <div class="card">
      <div class="card-title">Detalhamento dos Cones de Visão e Frustums (LiDAR + Câmera)</div>
      <div id="nmpc-details"></div>
