        <td>${c[0]}</td>
        <td>${c[1] ? 'Em Conformidade Estrita' : 'Violação Detectada'}</td>
      </tr>`).join('');

      drawMap(snap);
    }

    // Renderizador de Mapa 2D Town10 em Canvas
    function drawMap(snap) {
