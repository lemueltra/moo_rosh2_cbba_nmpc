[3.959064] (atas_optimizer) StdoutLine: {'line': b"12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';\n"}
[3.959114] (atas_optimizer) StdoutLine: {'line': b'12:         ctx.beginPath();\n'}
