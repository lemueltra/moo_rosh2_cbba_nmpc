[3.957834] (atas_optimizer) StdoutLine: {'line': b'12:       const refs = snap.references || [];\n'}
[3.957882] (atas_optimizer) StdoutLine: {'line': b'12:       for (const r of refs) {\n'}
[3.957931] (atas_optimizer) StdoutLine: {'line': b'12:         const u = ugvs[r.ugv_id];\n'}
[3.957979] (atas_optimizer) StdoutLine: {'line': b'12:         if (!u) continue;\n'}
[3.958027] (atas_optimizer) StdoutLine: {'line': b'12:         const cos_u = Math.cos(u.yaw);\n'}
[3.958076] (atas_optimizer) StdoutLine: {'line': b'12:         const sin_u = Math.sin(u.yaw);\n'}
[3.958123] (atas_optimizer) StdoutLine: {'line': b'12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);\n'}
[3.958172] (atas_optimizer) StdoutLine: {'line': b'12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);\n'}
