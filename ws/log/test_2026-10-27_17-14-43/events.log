[3.958813] (atas_optimizer) StdoutLine: {'line': b'12:         ctx.stroke();\n'}
[3.958863] (atas_optimizer) StdoutLine: {'line': b'12:         ctx.setLineDash([]);\n'}
[3.958912] (atas_optimizer) StdoutLine: {'line': b'12: \n'}
