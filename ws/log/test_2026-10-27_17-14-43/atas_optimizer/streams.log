[4.097s] 12:         ctx.closePath();
[4.097s] 12:         ctx.fill();
[4.097s] 12: 
[4.097s] 12:         // UAV Circle
[4.097s] 12:         ctx.fillStyle = '#38bdf8';
[4.097s] 12:         ctx.beginPath();
[4.097s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
[4.097s] 12:         ctx.fill();
[4.097s] 12:         ctx.fillStyle = '#fff';
