[3.725s] 12:       document.getElementById('kpi-time').textContent = (m.mean_solve_time_ms || 1.8).toFixed(1) + ' ms';
[3.725s] 12:       const activeIds = snap.active_ids || [];
[3.725s] 12:       document.getElementById('kpi-drones').textContent = `${activeIds.length} / ${snap.total_drones_max || 5}`;
[3.725s] 12: 
[3.725s] 12:       // Tabela UAVs
[3.725s] 12:       const refs = snap.references || [];
[3.725s] 12:       const tbody = document.getElementById('table-uavs');
[3.725s] 12:       if (refs.length === 0) {
[3.725s] 12:         tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-dim);">Drones em repouso na base.</td></tr>';
[3.725s] 12:       } else {
[3.725s] 12:         tbody.innerHTML = refs.map(r => {
[3.726s] 12:           const g = r.geom || {};
[3.726s] 12:           const isFov = g.in_any;
[3.726s] 12:           return `<tr>
[3.726s] 12:             <td><strong>#${r.drone_id}</strong></td>
[3.726s] 12:             <td>UGV #${r.ugv_id}</td>
[3.726s] 12:             <td>${(g.dist_3d || 0).toFixed(1)} m</td>
[3.726s] 12:             <td>${r.altitude_z.toFixed(1)} m</td>
[3.726s] 12:             <td>${(g.azimuth_deg || 0).toFixed(1)}°</td>
[3.726s] 12:             <td>${g.in_lidar ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
[3.726s] 12:             <td>${g.in_camera ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
[3.726s] 12:             <td><span class="badge ${isFov ? 'badge-ok' : 'badge-danger'}">${isFov ? 'CONFORME' : 'VIOLAÇÃO'}</span></td>
[3.726s] 12:             <td><span class="badge ${r.occluded ? 'badge-danger' : 'badge-ok'}">${r.occluded ? 'OCLUÍDO' : 'LIVRE'}</span></td>
[3.726s] 12:           </tr>`;
[3.726s] 12:         }).join('');
[3.726s] 12:       }
[3.726s] 12: 
[3.726s] 12:       // Tabela CBBA
[3.726s] 12:       const cbbaTbody = document.getElementById('table-cbba');
[3.726s] 12:       let cbbaHtml = '';
[3.726s] 12:       for (let i = 0; i < (snap.total_drones_max || 5); i++) {
[3.726s] 12:         const isActive = activeIds.includes(i);
[3.726s] 12:         const ref = refs.find(r => r.drone_id === i);
[3.726s] 12:         const ugvId = ref ? `UGV #${ref.ugv_id}` : 'Nenhum';
[3.726s] 12:         cbbaHtml += `<tr>
[3.726s] 12:           <td><strong>#${i}</strong></td>
[3.727s] 12:           <td><span class="badge ${isActive ? 'badge-ok' : 'badge-warn'}">${isActive ? 'ATIVO' : 'STANDBY'}</span></td>
[3.727s] 12:           <td>${ugvId}</td>
[3.727s] 12:           <td>${isActive ? 'Tamanho 1' : 'Vazio'}</td>
[3.727s] 12:           <td><span class="badge badge-ok">GARANTIDO</span></td>
[3.727s] 12:           <td>${isActive ? '+1.5x' : '0.0x'}</td>
[3.727s] 12:           <td><span style="color: var(--green);">CONVERGIDO</span></td>
[3.727s] 12:         </tr>`;
[3.727s] 12:       }
[3.727s] 12:       cbbaTbody.innerHTML = cbbaHtml;
[3.727s] 12: 
[3.727s] 12:       // NMPC Details
[3.727s] 12:       const nmpcDiv = document.getElementById('nmpc-details');
[3.727s] 12:       nmpcDiv.innerHTML = refs.map(r => {
[3.727s] 12:         const g = r.geom || {};
[3.728s] 12:         return `<div style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; margin-bottom: 10px; border-left: 4px solid var(--accent);">
[3.728s] 12:           <h4 style="margin-bottom: 6px;">UAV #${r.drone_id} escoltando UGV #${r.ugv_id}</h4>
[3.728s] 12:           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; font-size: 0.85rem;">
[3.728s] 12:             <div><strong>LiDAR (100m, 120°):</strong> ${g.in_lidar ? 'DENTRO' : 'FORA'} (Elev: ${(g.elev_deg||0).toFixed(1)}°)</div>
[3.728s] 12:             <div><strong>Câmera (40m, 90°):</strong> ${g.in_camera ? 'DENTRO' : 'FORA'} (Pitch: ${(g.pitch_deg||0).toFixed(1)}°)</div>
[3.728s] 12:             <div><strong>Pose Relativa:</strong> dx=${r.rel_x.toFixed(1)}m, dy=${r.rel_y.toFixed(1)}m, z=${r.altitude_z.toFixed(1)}m</div>
[3.728s] 12:             <div><strong>Requisito Primordial:</strong> <span style="color:${g.in_any ? 'var(--green)':'var(--red)'}; font-weight:bold;">${g.in_any ? 'ATENDIDO (100%)' : 'VIOLADO'}</span></div>
[3.728s] 12:           </div>
[3.728s] 12:         </div>`;
[3.728s] 12:       }).join('') || '<p style="color:var(--text-dim);">Nenhum UAV ativo no momento.</p>';
[3.728s] 12: 
[3.728s] 12:       // Auditoria
[3.728s] 12:       const auditTbody = document.getElementById('table-audit');
[3.729s] 12:       const checks = [
[3.729s] 12:         ["Sincronismo de Relógio Autorizado (/clock @ 50 Hz)", isSim],
[3.729s] 12:         ["Taxa de Publicação de Referências cravada em 5.0 Hz", isSim],
[3.729s] 12:         ["Envelope de Altitude z in [2.5, 35.0] m", (m.altitude_violations || 0) === 0],
[3.729s] 12:         ["Semântica de Coordenadas Relativas ao UGV", true],
[3.729s] 12:         ["Restrição Primordial de FoV de Sensor Duplo", (m.fov_violations || 0) === 0],
[3.730s] 12:         ["Vínculo Estrito CBBA (M >= 1)", true],
[3.730s] 12:         ["Solver Deadline (< 40.0 ms)", (m.mean_solve_time_ms || 0) < 40.0],
[3.731s] 12:         ["Isolamento de Atuação do Drake", true]
[3.731s] 12:       ];
[3.731s] 12:       auditTbody.innerHTML = checks.map(c => `<tr>
[3.731s] 12:         <td><span class="badge ${c[1] ? 'badge-ok' : 'badge-danger'}">${c[1] ? 'PASSOU' : 'FALHOU'}</span></td>
[3.731s] 12:         <td>${c[0]}</td>
[3.731s] 12:         <td>${c[1] ? 'Em Conformidade Estrita' : 'Violação Detectada'}</td>
[3.731s] 12:       </tr>`).join('');
[3.731s] 12: 
[3.731s] 12:       drawMap(snap);
[3.731s] 12:     }
[3.731s] 12: 
[3.731s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[3.732s] 12:     function drawMap(snap) {
[3.732s] 12:       const cvs = document.getElementById('map-canvas');
[3.732s] 12:       if (!cvs) return;
[3.732s] 12:       const ctx = cvs.getContext('2d');
[3.732s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[3.732s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[3.732s] 12: 
[3.732s] 12:       ctx.fillStyle = '#080c14';
[3.732s] 12:       ctx.fillRect(0, 0, w, h);
[3.732s] 12: 
[3.732s] 12:       // Centro em (0, 0)
[3.732s] 12:       const cx = w / 2;
[3.732s] 12:       const cy = h / 2;
[3.732s] 12:       const scale = 2.0; // pixels por metro
[3.733s] 12: 
[3.733s] 12:       // Grade
[3.733s] 12:       ctx.strokeStyle = '#1e293b';
[3.733s] 12:       ctx.lineWidth = 1;
[3.733s] 12:       for (let x = -200; x <= 200; x += 20) {
[3.733s] 12:         ctx.beginPath();
[3.733s] 12:         ctx.moveTo(cx + x * scale, 0);
[3.733s] 12:         ctx.lineTo(cx + x * scale, h);
[3.733s] 12:         ctx.stroke();
[3.733s] 12:       }
[3.733s] 12:       for (let y = -200; y <= 200; y += 20) {
[3.733s] 12:         ctx.beginPath();
[3.733s] 12:         ctx.moveTo(0, cy - y * scale);
[3.733s] 12:         ctx.lineTo(w, cy - y * scale);
[3.733s] 12:         ctx.stroke();
[3.733s] 12:       }
[3.733s] 12: 
[3.733s] 12:       // Desenhar Prédios Town10
[3.733s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[3.734s] 12:       ctx.strokeStyle = '#64748b';
[3.734s] 12:       for (const b of [
[3.734s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[3.734s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[3.734s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[3.734s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[3.734s] 12:       ]) {
[3.734s] 12:         const bx = cx + b.min_x * scale;
[3.734s] 12:         const by = cy - b.max_y * scale;
[3.734s] 12:         const bw = (b.max_x - b.min_x) * scale;
[3.734s] 12:         const bh = (b.max_y - b.min_y) * scale;
[3.734s] 12:         ctx.fillRect(bx, by, bw, bh);
[3.734s] 12:         ctx.strokeRect(bx, by, bw, bh);
[3.734s] 12:       }
[3.734s] 12: 
[3.734s] 12:       // Desenhar UGVs
[3.734s] 12:       const ugvs = snap.ugvs || {};
[3.734s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[3.734s] 12:         const ux = cx + u.x * scale;
[3.735s] 12:         const uy = cy - u.y * scale;
[3.735s] 12:         ctx.fillStyle = '#f59e0b';
[3.735s] 12:         ctx.beginPath();
[3.735s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[3.735s] 12:         ctx.fill();
[3.735s] 12:         ctx.fillStyle = '#fff';
[3.735s] 12:         ctx.font = '10px monospace';
[3.735s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[3.735s] 12:       }
[3.735s] 12: 
[3.735s] 12:       // Desenhar UAVs e Frustums
[3.735s] 12:       const refs = snap.references || [];
[3.735s] 12:       for (const r of refs) {
[3.735s] 12:         const u = ugvs[r.ugv_id];
[3.735s] 12:         if (!u) continue;
[3.735s] 12:         const cos_u = Math.cos(u.yaw);
[3.735s] 12:         const sin_u = Math.sin(u.yaw);
[3.735s] 12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
[3.735s] 12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
[3.735s] 12: 
[3.735s] 12:         const dx = cx + drone_wx * scale;
[3.736s] 12:         const dy = cy - drone_wy * scale;
[3.736s] 12:         const ux = cx + u.x * scale;
[3.736s] 12:         const uy = cy - u.y * scale;
[3.736s] 12: 
[3.736s] 12:         // Linha de Visada UAV -> UGV
[3.736s] 12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
[3.736s] 12:         ctx.setLineDash([4, 4]);
[3.736s] 12:         ctx.beginPath();
[3.736s] 12:         ctx.moveTo(dx, dy);
[3.736s] 12:         ctx.lineTo(ux, uy);
[3.736s] 12:         ctx.stroke();
[3.736s] 12:         ctx.setLineDash([]);
[3.736s] 12: 
[3.736s] 12:         // Cone de Câmera (90°)
[3.736s] 12:         const yaw_world = u.yaw + r.rel_yaw;
[3.736s] 12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
[3.736s] 12:         ctx.beginPath();
[3.736s] 12:         ctx.moveTo(dx, dy);
[3.736s] 12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
[3.736s] 12:         ctx.closePath();
[3.736s] 12:         ctx.fill();
[3.736s] 12: 
[3.737s] 12:         // UAV Circle
[3.737s] 12:         ctx.fillStyle = '#38bdf8';
[3.737s] 12:         ctx.beginPath();
[3.737s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
[3.737s] 12:         ctx.fill();
[3.737s] 12:         ctx.fillStyle = '#fff';
[3.737s] 12:         ctx.fillText(`UAV ${r.drone_id}`, dx + 10, dy + 3);
[3.737s] 12:       }
[3.737s] 12:     }
[3.737s] 12:   </script>
[3.737s] 12: </body>
[3.737s] 12: </html>
[3.737s] 12: """
