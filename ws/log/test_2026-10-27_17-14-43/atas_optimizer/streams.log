[4.088s] 12:       document.getElementById('kpi-fov-sub').textContent = `${m.fov_violations || 0} violações / ${m.total_evaluations || 0}`;
[4.088s] 12:       document.getElementById('kpi-lat').textContent = (snap.mean_latency_ms || 15.0).toFixed(1) + ' ms';
[4.088s] 12:       document.getElementById('kpi-time').textContent = (m.mean_solve_time_ms || 1.8).toFixed(1) + ' ms';
[4.088s] 12:       const activeIds = snap.active_ids || [];
[4.088s] 12:       document.getElementById('kpi-drones').textContent = `${activeIds.length} / ${snap.total_drones_max || 5}`;
[4.088s] 12: 
[4.088s] 12:       // Tabela UAVs
[4.088s] 12:       const refs = snap.references || [];
[4.088s] 12:       const tbody = document.getElementById('table-uavs');
[4.088s] 12:       if (refs.length === 0) {
[4.088s] 12:         tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-dim);">Drones em repouso na base.</td></tr>';
[4.088s] 12:       } else {
[4.088s] 12:         tbody.innerHTML = refs.map(r => {
[4.088s] 12:           const g = r.geom || {};
[4.089s] 12:           const isFov = g.in_any;
[4.089s] 12:           return `<tr>
[4.089s] 12:             <td><strong>#${r.drone_id}</strong></td>
[4.089s] 12:             <td>UGV #${r.ugv_id}</td>
[4.089s] 12:             <td>${(g.dist_3d || 0).toFixed(1)} m</td>
[4.089s] 12:             <td>${r.altitude_z.toFixed(1)} m</td>
[4.089s] 12:             <td>${(g.azimuth_deg || 0).toFixed(1)}°</td>
[4.089s] 12:             <td>${g.in_lidar ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
[4.089s] 12:             <td>${g.in_camera ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
[4.089s] 12:             <td><span class="badge ${isFov ? 'badge-ok' : 'badge-danger'}">${isFov ? 'CONFORME' : 'VIOLAÇÃO'}</span></td>
[4.089s] 12:             <td><span class="badge ${r.occluded ? 'badge-danger' : 'badge-ok'}">${r.occluded ? 'OCLUÍDO' : 'LIVRE'}</span></td>
[4.089s] 12:           </tr>`;
[4.089s] 12:         }).join('');
[4.089s] 12:       }
[4.089s] 12: 
[4.089s] 12:       // Tabela CBBA
[4.089s] 12:       const cbbaTbody = document.getElementById('table-cbba');
[4.089s] 12:       let cbbaHtml = '';
[4.089s] 12:       for (let i = 0; i < (snap.total_drones_max || 5); i++) {
[4.089s] 12:         const isActive = activeIds.includes(i);
[4.090s] 12:         const ref = refs.find(r => r.drone_id === i);
[4.090s] 12:         const ugvId = ref ? `UGV #${ref.ugv_id}` : 'Nenhum';
[4.090s] 12:         cbbaHtml += `<tr>
[4.090s] 12:           <td><strong>#${i}</strong></td>
[4.090s] 12:           <td><span class="badge ${isActive ? 'badge-ok' : 'badge-warn'}">${isActive ? 'ATIVO' : 'STANDBY'}</span></td>
[4.090s] 12:           <td>${ugvId}</td>
[4.090s] 12:           <td>${isActive ? 'Tamanho 1' : 'Vazio'}</td>
[4.090s] 12:           <td><span class="badge badge-ok">GARANTIDO</span></td>
[4.090s] 12:           <td>${isActive ? '+1.5x' : '0.0x'}</td>
[4.090s] 12:           <td><span style="color: var(--green);">CONVERGIDO</span></td>
[4.090s] 12:         </tr>`;
[4.090s] 12:       }
[4.090s] 12:       cbbaTbody.innerHTML = cbbaHtml;
[4.090s] 12: 
[4.090s] 12:       // NMPC Details
[4.090s] 12:       const nmpcDiv = document.getElementById('nmpc-details');
[4.090s] 12:       nmpcDiv.innerHTML = refs.map(r => {
[4.090s] 12:         const g = r.geom || {};
[4.090s] 12:         return `<div style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; margin-bottom: 10px; border-left: 4px solid var(--accent);">
[4.091s] 12:           <h4 style="margin-bottom: 6px;">UAV #${r.drone_id} escoltando UGV #${r.ugv_id}</h4>
[4.091s] 12:           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; font-size: 0.85rem;">
[4.091s] 12:             <div><strong>LiDAR (100m, 120°):</strong> ${g.in_lidar ? 'DENTRO' : 'FORA'} (Elev: ${(g.elev_deg||0).toFixed(1)}°)</div>
[4.091s] 12:             <div><strong>Câmera (40m, 90°):</strong> ${g.in_camera ? 'DENTRO' : 'FORA'} (Pitch: ${(g.pitch_deg||0).toFixed(1)}°)</div>
[4.091s] 12:             <div><strong>Pose Relativa:</strong> dx=${r.rel_x.toFixed(1)}m, dy=${r.rel_y.toFixed(1)}m, z=${r.altitude_z.toFixed(1)}m</div>
[4.091s] 12:             <div><strong>Requisito Primordial:</strong> <span style="color:${g.in_any ? 'var(--green)':'var(--red)'}; font-weight:bold;">${g.in_any ? 'ATENDIDO (100%)' : 'VIOLADO'}</span></div>
[4.091s] 12:           </div>
[4.091s] 12:         </div>`;
[4.091s] 12:       }).join('') || '<p style="color:var(--text-dim);">Nenhum UAV ativo no momento.</p>';
[4.091s] 12: 
[4.091s] 12:       // Auditoria
[4.091s] 12:       const auditTbody = document.getElementById('table-audit');
[4.091s] 12:       const checks = [
[4.091s] 12:         ["Sincronismo de Relógio Autorizado (/clock @ 50 Hz)", isSim],
[4.091s] 12:         ["Taxa de Publicação de Referências cravada em 5.0 Hz", isSim],
[4.091s] 12:         ["Envelope de Altitude z in [2.5, 35.0] m", (m.altitude_violations || 0) === 0],
[4.091s] 12:         ["Semântica de Coordenadas Relativas ao UGV", true],
[4.092s] 12:         ["Restrição Primordial de FoV de Sensor Duplo", (m.fov_violations || 0) === 0],
[4.092s] 12:         ["Vínculo Estrito CBBA (M >= 1)", true],
[4.092s] 12:         ["Solver Deadline (< 40.0 ms)", (m.mean_solve_time_ms || 0) < 40.0],
[4.092s] 12:         ["Isolamento de Atuação do Drake", true]
[4.092s] 12:       ];
[4.092s] 12:       auditTbody.innerHTML = checks.map(c => `<tr>
[4.092s] 12:         <td><span class="badge ${c[1] ? 'badge-ok' : 'badge-danger'}">${c[1] ? 'PASSOU' : 'FALHOU'}</span></td>
[4.092s] 12:         <td>${c[0]}</td>
[4.092s] 12:         <td>${c[1] ? 'Em Conformidade Estrita' : 'Violação Detectada'}</td>
[4.092s] 12:       </tr>`).join('');
[4.092s] 12: 
[4.092s] 12:       drawMap(snap);
[4.092s] 12:     }
[4.092s] 12: 
[4.092s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[4.092s] 12:     function drawMap(snap) {
[4.092s] 12:       const cvs = document.getElementById('map-canvas');
[4.092s] 12:       if (!cvs) return;
[4.092s] 12:       const ctx = cvs.getContext('2d');
[4.092s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[4.093s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[4.093s] 12: 
[4.093s] 12:       ctx.fillStyle = '#080c14';
[4.093s] 12:       ctx.fillRect(0, 0, w, h);
[4.093s] 12: 
[4.093s] 12:       // Centro em (0, 0)
[4.093s] 12:       const cx = w / 2;
[4.093s] 12:       const cy = h / 2;
[4.093s] 12:       const scale = 2.0; // pixels por metro
[4.093s] 12: 
[4.093s] 12:       // Grade
[4.093s] 12:       ctx.strokeStyle = '#1e293b';
[4.093s] 12:       ctx.lineWidth = 1;
[4.093s] 12:       for (let x = -200; x <= 200; x += 20) {
[4.093s] 12:         ctx.beginPath();
[4.093s] 12:         ctx.moveTo(cx + x * scale, 0);
[4.093s] 12:         ctx.lineTo(cx + x * scale, h);
[4.093s] 12:         ctx.stroke();
[4.093s] 12:       }
[4.093s] 12:       for (let y = -200; y <= 200; y += 20) {
[4.094s] 12:         ctx.beginPath();
[4.094s] 12:         ctx.moveTo(0, cy - y * scale);
[4.094s] 12:         ctx.lineTo(w, cy - y * scale);
[4.094s] 12:         ctx.stroke();
[4.094s] 12:       }
[4.094s] 12: 
[4.094s] 12:       // Desenhar Prédios Town10
[4.094s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[4.094s] 12:       ctx.strokeStyle = '#64748b';
[4.094s] 12:       for (const b of [
[4.094s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[4.094s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[4.094s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[4.094s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[4.094s] 12:       ]) {
[4.094s] 12:         const bx = cx + b.min_x * scale;
[4.094s] 12:         const by = cy - b.max_y * scale;
[4.094s] 12:         const bw = (b.max_x - b.min_x) * scale;
[4.094s] 12:         const bh = (b.max_y - b.min_y) * scale;
[4.094s] 12:         ctx.fillRect(bx, by, bw, bh);
[4.094s] 12:         ctx.strokeRect(bx, by, bw, bh);
[4.095s] 12:       }
[4.095s] 12: 
[4.095s] 12:       // Desenhar UGVs
[4.095s] 12:       const ugvs = snap.ugvs || {};
[4.095s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[4.095s] 12:         const ux = cx + u.x * scale;
[4.095s] 12:         const uy = cy - u.y * scale;
[4.095s] 12:         ctx.fillStyle = '#f59e0b';
[4.095s] 12:         ctx.beginPath();
[4.095s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[4.095s] 12:         ctx.fill();
[4.095s] 12:         ctx.fillStyle = '#fff';
[4.095s] 12:         ctx.font = '10px monospace';
[4.095s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[4.095s] 12:       }
[4.095s] 12: 
[4.095s] 12:       // Desenhar UAVs e Frustums
[4.095s] 12:       const refs = snap.references || [];
[4.095s] 12:       for (const r of refs) {
