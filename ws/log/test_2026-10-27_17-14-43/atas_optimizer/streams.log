[4.250s] 12:         ctx.beginPath();
[4.250s] 12:         ctx.moveTo(dx, dy);
[4.250s] 12:         ctx.lineTo(ux, uy);
[4.250s] 12:         ctx.stroke();
[4.250s] 12:         ctx.setLineDash([]);
