[4.270s] 12:       auditTbody.innerHTML = checks.map(c => `<tr>
[4.270s] 12:         <td><span class="badge ${c[1] ? 'badge-ok' : 'badge-danger'}">${c[1] ? 'PASSOU' : 'FALHOU'}</span></td>
