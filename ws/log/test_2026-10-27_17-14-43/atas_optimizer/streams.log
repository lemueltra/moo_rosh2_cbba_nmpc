[4.220s] 12:       
[4.220s] 12:                         
[4.220s] 12:              ^
[4.220s] 12:         return """<!DOCTYPE html>
[4.220s] 12: <html lang="pt-BR">
[4.220s] 12: <head>
[4.220s] 12:   <meta charset="UTF-8">
