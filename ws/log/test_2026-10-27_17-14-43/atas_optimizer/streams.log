[4.044s] 12:       document.getElementById('kpi-time').textContent = (m.mean_solve_time_ms || 1.8).toFixed(1) + ' ms';
[4.044s] 12:       const activeIds = snap.active_ids || [];
[4.044s] 12:       document.getElementById('kpi-drones').textContent = `${activeIds.length} / ${snap.total_drones_max || 5}`;
[4.044s] 12: 
[4.044s] 12:       // Tabela UAVs
[4.044s] 12:       const refs = snap.references || [];
[4.044s] 12:       const tbody = document.getElementById('table-uavs');
[4.044s] 12:       if (refs.length === 0) {
[4.044s] 12:         tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-dim);">Drones em repouso na base.</td></tr>';
[4.044s] 12:       } else {
[4.044s] 12:         tbody.innerHTML = refs.map(r => {
[4.044s] 12:           const g = r.geom || {};
[4.044s] 12:           const isFov = g.in_any;
[4.044s] 12:           return `<tr>
[4.044s] 12:             <td><strong>#${r.drone_id}</strong></td>
[4.044s] 12:             <td>UGV #${r.ugv_id}</td>
