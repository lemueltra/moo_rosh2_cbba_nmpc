[4.086s] 12:     let currentTab = 1;
[4.086s] 12:     function setTab(num) {
[4.087s] 12:       currentTab = num;
[4.087s] 12:       document.querySelectorAll('.tab-btn').forEach((b, idx) => {
[4.087s] 12:         b.classList.toggle('active', idx === (num - 1));
[4.087s] 12:       });
[4.087s] 12:       document.querySelectorAll('.tab-content').forEach((c, idx) => {
