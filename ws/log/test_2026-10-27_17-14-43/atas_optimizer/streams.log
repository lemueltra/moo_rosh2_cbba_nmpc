[4.250s] 12:         const uy = cy - u.y * scale;
[4.250s] 12: 
[4.250s] 12:         // Linha de Visada UAV -> UGV
[4.250s] 12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
