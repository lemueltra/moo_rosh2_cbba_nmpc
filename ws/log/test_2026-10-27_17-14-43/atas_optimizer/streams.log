[4.186s] 12:         const ugvId = ref ? `UGV #${ref.ugv_id}` : 'Nenhum';
[4.186s] 12:         cbbaHtml += `<tr>
[4.186s] 12:           <td><strong>#${i}</strong></td>
[4.186s] 12:           <td><span class="badge ${isActive ? 'badge-ok' : 'badge-warn'}">${isActive ? 'ATIVO' : 'STANDBY'}</span></td>
[4.186s] 12:           <td>${ugvId}</td>
[4.186s] 12:           <td>${isActive ? 'Tamanho 1' : 'Vazio'}</td>
