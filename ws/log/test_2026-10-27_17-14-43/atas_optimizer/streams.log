[4.096s] 12:         const dx = cx + drone_wx * scale;
[4.096s] 12:         const dy = cy - drone_wy * scale;
[4.096s] 12:         const ux = cx + u.x * scale;
[4.096s] 12:         const uy = cy - u.y * scale;
