[4.475s] 12:         ctx.beginPath();
[4.475s] 12:         ctx.moveTo(dx, dy);
[4.475s] 12:         ctx.lineTo(ux, uy);
[4.475s] 12:         ctx.stroke();
[4.475s] 12:         ctx.setLineDash([]);
