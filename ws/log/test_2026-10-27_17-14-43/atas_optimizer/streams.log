[3.725s] 12:       statusBadge.className = isSim ? 'badge badge-ok' : 'badge badge-danger';
[3.725s] 12:       document.getElementById('clock-display').textContent = `SimTime: ${snap.timestamp_sim.toFixed(2)}s | ${snap.clock_hz.toFixed(1)} Hz`;
[3.725s] 12: 
[3.725s] 12:       // KPIs
