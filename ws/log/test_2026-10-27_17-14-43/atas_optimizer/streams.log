[4.087s] 12:       });
[4.087s] 12:     }
[4.087s] 12: 
[4.087s] 12:     const evtSource = new EventSource('/events');
[4.087s] 12:     evtSource.onmessage = function(e) {
[4.087s] 12:       const snap = JSON.parse(e.data);
[4.087s] 12:       updateDashboard(snap);
[4.087s] 12:     };
[4.087s] 12: 
[4.087s] 12:     function updateDashboard(snap) {
[4.087s] 12:       // Header
