[4.300s] 12:         // Cone de Câmera (90°)
[4.300s] 12:         const yaw_world = u.yaw + r.rel_yaw;
[4.300s] 12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
[4.300s] 12:         ctx.beginPath();
[4.300s] 12:         ctx.moveTo(dx, dy);
[4.300s] 12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
[4.300s] 12:         ctx.closePath();
[4.300s] 12:         ctx.fill();
[4.301s] 12: 
[4.301s] 12:         // UAV Circle
[4.301s] 12:         ctx.fillStyle = '#38bdf8';
[4.301s] 12:         ctx.beginPath();
[4.301s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
[4.301s] 12:         ctx.fill();
[4.301s] 12:         ctx.fillStyle = '#fff';
[4.301s] 12:         ctx.fillText(`UAV ${r.drone_id}`, dx + 10, dy + 3);
[4.301s] 12:       }
