[3.793s] 12:         // Cone de Câmera (90°)
[3.793s] 12:         const yaw_world = u.yaw + r.rel_yaw;
[3.793s] 12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
[3.793s] 12:         ctx.beginPath();
[3.793s] 12:         ctx.moveTo(dx, dy);
[3.793s] 12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
[3.793s] 12:         ctx.closePath();
[3.793s] 12:         ctx.fill();
[3.793s] 12: 
[3.793s] 12:         // UAV Circle
[3.793s] 12:         ctx.fillStyle = '#38bdf8';
[3.793s] 12:         ctx.beginPath();
[3.793s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
