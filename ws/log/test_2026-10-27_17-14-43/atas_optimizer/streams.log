[4.008s] 12:         const sin_u = Math.sin(u.yaw);
[4.008s] 12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
[4.008s] 12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
[4.008s] 12: 
[4.008s] 12:         const dx = cx + drone_wx * scale;
[4.008s] 12:         const dy = cy - drone_wy * scale;
[4.008s] 12:         const ux = cx + u.x * scale;
[4.008s] 12:         const uy = cy - u.y * scale;
[4.008s] 12: 
[4.009s] 12:         // Linha de Visada UAV -> UGV
[4.009s] 12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
