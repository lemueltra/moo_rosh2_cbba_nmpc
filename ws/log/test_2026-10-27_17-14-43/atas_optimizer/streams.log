[4.248s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[4.248s] 12:       }
[4.249s] 12: 
[4.249s] 12:       // Desenhar UAVs e Frustums
[4.249s] 12:       const refs = snap.references || [];
[4.249s] 12:       for (const r of refs) {
