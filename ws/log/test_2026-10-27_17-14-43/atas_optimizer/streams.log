[4.389s] 12: 
[4.389s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[4.389s] 12:     function drawMap(snap) {
[4.390s] 12:       const cvs = document.getElementById('map-canvas');
[4.390s] 12:       if (!cvs) return;
[4.390s] 12:       const ctx = cvs.getContext('2d');
[4.390s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[4.390s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[4.390s] 12: 
[4.390s] 12:       ctx.fillStyle = '#080c14';
[4.390s] 12:       ctx.fillRect(0, 0, w, h);
[4.390s] 12: 
[4.391s] 12:       // Centro em (0, 0)
[4.391s] 12:       const cx = w / 2;
[4.391s] 12:       const cy = h / 2;
[4.391s] 12:       const scale = 2.0; // pixels por metro
[4.391s] 12: 
[4.391s] 12:       // Grade
[4.391s] 12:       ctx.strokeStyle = '#1e293b';
[4.391s] 12:       ctx.lineWidth = 1;
[4.391s] 12:       for (let x = -200; x <= 200; x += 20) {
[4.392s] 12:         ctx.beginPath();
[4.392s] 12:         ctx.moveTo(cx + x * scale, 0);
[4.392s] 12:         ctx.lineTo(cx + x * scale, h);
[4.392s] 12:         ctx.stroke();
[4.392s] 12:       }
[4.392s] 12:       for (let y = -200; y <= 200; y += 20) {
[4.392s] 12:         ctx.beginPath();
[4.392s] 12:         ctx.moveTo(0, cy - y * scale);
[4.393s] 12:         ctx.lineTo(w, cy - y * scale);
[4.393s] 12:         ctx.stroke();
[4.393s] 12:       }
[4.393s] 12: 
[4.393s] 12:       // Desenhar Prédios Town10
[4.393s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[4.393s] 12:       ctx.strokeStyle = '#64748b';
[4.393s] 12:       for (const b of [
[4.394s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[4.394s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[4.394s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[4.394s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[4.394s] 12:       ]) {
[4.394s] 12:         const bx = cx + b.min_x * scale;
[4.394s] 12:         const by = cy - b.max_y * scale;
[4.394s] 12:         const bw = (b.max_x - b.min_x) * scale;
[4.394s] 12:         const bh = (b.max_y - b.min_y) * scale;
[4.395s] 12:         ctx.fillRect(bx, by, bw, bh);
[4.395s] 12:         ctx.strokeRect(bx, by, bw, bh);
[4.395s] 12:       }
[4.395s] 12: 
[4.395s] 12:       // Desenhar UGVs
[4.395s] 12:       const ugvs = snap.ugvs || {};
[4.395s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[4.395s] 12:         const ux = cx + u.x * scale;
[4.395s] 12:         const uy = cy - u.y * scale;
[4.396s] 12:         ctx.fillStyle = '#f59e0b';
[4.396s] 12:         ctx.beginPath();
[4.396s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[4.396s] 12:         ctx.fill();
[4.396s] 12:         ctx.fillStyle = '#fff';
[4.396s] 12:         ctx.font = '10px monospace';
[4.396s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[4.396s] 12:       }
[4.396s] 12: 
[4.397s] 12:       // Desenhar UAVs e Frustums
[4.397s] 12:       const refs = snap.references || [];
[4.397s] 12:       for (const r of refs) {
[4.397s] 12:         const u = ugvs[r.ugv_id];
[4.397s] 12:         if (!u) continue;
[4.397s] 12:         const cos_u = Math.cos(u.yaw);
[4.397s] 12:         const sin_u = Math.sin(u.yaw);
[4.397s] 12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
[4.397s] 12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
[4.398s] 12: 
[4.398s] 12:         const dx = cx + drone_wx * scale;
[4.398s] 12:         const dy = cy - drone_wy * scale;
[4.398s] 12:         const ux = cx + u.x * scale;
[4.398s] 12:         const uy = cy - u.y * scale;
[4.398s] 12: 
[4.398s] 12:         // Linha de Visada UAV -> UGV
[4.398s] 12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
[4.399s] 12:         ctx.setLineDash([4, 4]);
[4.399s] 12:         ctx.beginPath();
[4.399s] 12:         ctx.moveTo(dx, dy);
[4.399s] 12:         ctx.lineTo(ux, uy);
[4.399s] 12:         ctx.stroke();
[4.399s] 12:         ctx.setLineDash([]);
[4.399s] 12: 
[4.399s] 12:         // Cone de Câmera (90°)
[4.400s] 12:         const yaw_world = u.yaw + r.rel_yaw;
[4.400s] 12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
[4.400s] 12:         ctx.beginPath();
[4.400s] 12:         ctx.moveTo(dx, dy);
[4.400s] 12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
[4.400s] 12:         ctx.closePath();
[4.400s] 12:         ctx.fill();
[4.400s] 12: 
[4.400s] 12:         // UAV Circle
[4.401s] 12:         ctx.fillStyle = '#38bdf8';
[4.401s] 12:         ctx.beginPath();
[4.401s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
