[4.251s] 12:         ctx.moveTo(dx, dy);
[4.251s] 12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
[4.251s] 12:         ctx.closePath();
[4.251s] 12:         ctx.fill();
[4.251s] 12: 
[4.251s] 12:         // UAV Circle
[4.251s] 12:         ctx.fillStyle = '#38bdf8';
[4.252s] 12:         ctx.beginPath();
[4.252s] 12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
[4.252s] 12:         ctx.fill();
[4.252s] 12:         ctx.fillStyle = '#fff';
[4.252s] 12:         ctx.fillText(`UAV ${r.drone_id}`, dx + 10, dy + 3);
