[3.750s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[3.750s] 12:     function drawMap(snap) {
[3.750s] 12:       const cvs = document.getElementById('map-canvas');
[3.750s] 12:       if (!cvs) return;
[3.750s] 12:       const ctx = cvs.getContext('2d');
[3.750s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[3.750s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[3.750s] 12: 
[3.750s] 12:       ctx.fillStyle = '#080c14';
[3.750s] 12:       ctx.fillRect(0, 0, w, h);
[3.750s] 12: 
[3.750s] 12:       // Centro em (0, 0)
[3.750s] 12:       const cx = w / 2;
[3.750s] 12:       const cy = h / 2;
[3.750s] 12:       const scale = 2.0; // pixels por metro
[3.750s] 12: 
[3.750s] 12:       // Grade
[3.750s] 12:       ctx.strokeStyle = '#1e293b';
[3.750s] 12:       ctx.lineWidth = 1;
[3.751s] 12:       for (let x = -200; x <= 200; x += 20) {
[3.751s] 12:         ctx.beginPath();
[3.751s] 12:         ctx.moveTo(cx + x * scale, 0);
[3.751s] 12:         ctx.lineTo(cx + x * scale, h);
[3.751s] 12:         ctx.stroke();
[3.751s] 12:       }
[3.751s] 12:       for (let y = -200; y <= 200; y += 20) {
[3.751s] 12:         ctx.beginPath();
[3.751s] 12:         ctx.moveTo(0, cy - y * scale);
[3.751s] 12:         ctx.lineTo(w, cy - y * scale);
[3.751s] 12:         ctx.stroke();
[3.751s] 12:       }
[3.751s] 12: 
[3.751s] 12:       // Desenhar Prédios Town10
[3.751s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[3.751s] 12:       ctx.strokeStyle = '#64748b';
[3.751s] 12:       for (const b of [
[3.751s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[3.751s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[3.751s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[3.751s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[3.751s] 12:       ]) {
[3.752s] 12:         const bx = cx + b.min_x * scale;
[3.752s] 12:         const by = cy - b.max_y * scale;
[3.752s] 12:         const bw = (b.max_x - b.min_x) * scale;
[3.752s] 12:         const bh = (b.max_y - b.min_y) * scale;
[3.752s] 12:         ctx.fillRect(bx, by, bw, bh);
[3.752s] 12:         ctx.strokeRect(bx, by, bw, bh);
[3.752s] 12:       }
[3.752s] 12: 
[3.752s] 12:       // Desenhar UGVs
[3.752s] 12:       const ugvs = snap.ugvs || {};
[3.752s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[3.752s] 12:         const ux = cx + u.x * scale;
[3.752s] 12:         const uy = cy - u.y * scale;
[3.752s] 12:         ctx.fillStyle = '#f59e0b';
[3.752s] 12:         ctx.beginPath();
[3.752s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[3.752s] 12:         ctx.fill();
[3.752s] 12:         ctx.fillStyle = '#fff';
[3.752s] 12:         ctx.font = '10px monospace';
[3.752s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[3.752s] 12:       }
[3.752s] 12: 
[3.752s] 12:       // Desenhar UAVs e Frustums
[3.753s] 12:       const refs = snap.references || [];
[3.753s] 12:       for (const r of refs) {
