[4.295s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[4.295s] 12:     function drawMap(snap) {
[4.295s] 12:       const cvs = document.getElementById('map-canvas');
[4.295s] 12:       if (!cvs) return;
[4.295s] 12:       const ctx = cvs.getContext('2d');
[4.295s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[4.295s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[4.296s] 12: 
[4.296s] 12:       ctx.fillStyle = '#080c14';
[4.296s] 12:       ctx.fillRect(0, 0, w, h);
[4.296s] 12: 
[4.296s] 12:       // Centro em (0, 0)
[4.296s] 12:       const cx = w / 2;
[4.296s] 12:       const cy = h / 2;
[4.296s] 12:       const scale = 2.0; // pixels por metro
[4.296s] 12: 
[4.296s] 12:       // Grade
[4.296s] 12:       ctx.strokeStyle = '#1e293b';
[4.296s] 12:       ctx.lineWidth = 1;
[4.296s] 12:       for (let x = -200; x <= 200; x += 20) {
[4.296s] 12:         ctx.beginPath();
[4.296s] 12:         ctx.moveTo(cx + x * scale, 0);
[4.296s] 12:         ctx.lineTo(cx + x * scale, h);
[4.296s] 12:         ctx.stroke();
[4.296s] 12:       }
[4.296s] 12:       for (let y = -200; y <= 200; y += 20) {
[4.297s] 12:         ctx.beginPath();
[4.297s] 12:         ctx.moveTo(0, cy - y * scale);
[4.297s] 12:         ctx.lineTo(w, cy - y * scale);
[4.297s] 12:         ctx.stroke();
[4.297s] 12:       }
[4.297s] 12: 
[4.297s] 12:       // Desenhar Prédios Town10
[4.297s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[4.297s] 12:       ctx.strokeStyle = '#64748b';
[4.297s] 12:       for (const b of [
[4.297s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[4.297s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[4.297s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[4.297s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[4.297s] 12:       ]) {
[4.297s] 12:         const bx = cx + b.min_x * scale;
[4.297s] 12:         const by = cy - b.max_y * scale;
[4.297s] 12:         const bw = (b.max_x - b.min_x) * scale;
[4.298s] 12:         const bh = (b.max_y - b.min_y) * scale;
[4.298s] 12:         ctx.fillRect(bx, by, bw, bh);
[4.298s] 12:         ctx.strokeRect(bx, by, bw, bh);
[4.298s] 12:       }
[4.298s] 12: 
[4.298s] 12:       // Desenhar UGVs
[4.298s] 12:       const ugvs = snap.ugvs || {};
[4.298s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[4.298s] 12:         const ux = cx + u.x * scale;
[4.298s] 12:         const uy = cy - u.y * scale;
[4.298s] 12:         ctx.fillStyle = '#f59e0b';
[4.298s] 12:         ctx.beginPath();
[4.298s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[4.298s] 12:         ctx.fill();
[4.298s] 12:         ctx.fillStyle = '#fff';
[4.298s] 12:         ctx.font = '10px monospace';
[4.298s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[4.298s] 12:       }
[4.299s] 12: 
[4.299s] 12:       // Desenhar UAVs e Frustums
[4.299s] 12:       const refs = snap.references || [];
[4.299s] 12:       for (const r of refs) {
[4.299s] 12:         const u = ugvs[r.ugv_id];
[4.299s] 12:         if (!u) continue;
[4.299s] 12:         const cos_u = Math.cos(u.yaw);
[4.299s] 12:         const sin_u = Math.sin(u.yaw);
[4.299s] 12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
[4.299s] 12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
[4.299s] 12: 
[4.299s] 12:         const dx = cx + drone_wx * scale;
[4.299s] 12:         const dy = cy - drone_wy * scale;
[4.299s] 12:         const ux = cx + u.x * scale;
[4.299s] 12:         const uy = cy - u.y * scale;
[4.299s] 12: 
[4.299s] 12:         // Linha de Visada UAV -> UGV
[4.299s] 12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
