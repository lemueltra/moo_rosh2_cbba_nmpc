[4.087s] 12:       statusBadge.textContent = isSim ? 'MALHA FECHADA ATIVA' : 'SIMULADOR PARADO';
[4.087s] 12:       statusBadge.className = isSim ? 'badge badge-ok' : 'badge badge-danger';
[4.088s] 12:       document.getElementById('clock-display').textContent = `SimTime: ${snap.timestamp_sim.toFixed(2)}s | ${snap.clock_hz.toFixed(1)} Hz`;
[4.088s] 12: 
[4.088s] 12:       // KPIs
[4.088s] 12:       const m = snap.metrics || {};
[4.088s] 12:       const fovPct = m.fov_compliance_percent || 100.0;
