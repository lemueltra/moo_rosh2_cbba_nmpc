[4.004s] 12:         ctx.moveTo(cx + x * scale, 0);
[4.004s] 12:         ctx.lineTo(cx + x * scale, h);
[4.004s] 12:         ctx.stroke();
[4.004s] 12:       }
[4.004s] 12:       for (let y = -200; y <= 200; y += 20) {
[4.004s] 12:         ctx.beginPath();
[4.004s] 12:         ctx.moveTo(0, cy - y * scale);
[4.004s] 12:         ctx.lineTo(w, cy - y * scale);
[4.004s] 12:         ctx.stroke();
[4.005s] 12:       }
[4.005s] 12: 
[4.005s] 12:       // Desenhar Prédios Town10
[4.005s] 12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
[4.005s] 12:       ctx.strokeStyle = '#64748b';
[4.005s] 12:       for (const b of [
[4.005s] 12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
[4.005s] 12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
[4.005s] 12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
[4.005s] 12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
[4.005s] 12:       ]) {
[4.005s] 12:         const bx = cx + b.min_x * scale;
[4.006s] 12:         const by = cy - b.max_y * scale;
[4.006s] 12:         const bw = (b.max_x - b.min_x) * scale;
[4.006s] 12:         const bh = (b.max_y - b.min_y) * scale;
[4.006s] 12:         ctx.fillRect(bx, by, bw, bh);
[4.006s] 12:         ctx.strokeRect(bx, by, bw, bh);
[4.006s] 12:       }
[4.006s] 12: 
[4.006s] 12:       // Desenhar UGVs
[4.006s] 12:       const ugvs = snap.ugvs || {};
[4.006s] 12:       for (const [id, u] of Object.entries(ugvs)) {
[4.006s] 12:         const ux = cx + u.x * scale;
[4.006s] 12:         const uy = cy - u.y * scale;
[4.007s] 12:         ctx.fillStyle = '#f59e0b';
[4.007s] 12:         ctx.beginPath();
[4.007s] 12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
[4.007s] 12:         ctx.fill();
[4.007s] 12:         ctx.fillStyle = '#fff';
[4.007s] 12:         ctx.font = '10px monospace';
[4.007s] 12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
[4.007s] 12:       }
[4.007s] 12: 
[4.007s] 12:       // Desenhar UAVs e Frustums
[4.007s] 12:       const refs = snap.references || [];
[4.007s] 12:       for (const r of refs) {
[4.008s] 12:         const u = ugvs[r.ugv_id];
