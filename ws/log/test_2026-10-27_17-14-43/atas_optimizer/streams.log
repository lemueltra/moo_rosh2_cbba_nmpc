[4.185s] 12:             <td><span class="badge ${isFov ? 'badge-ok' : 'badge-danger'}">${isFov ? 'CONFORME' : 'VIOLAÇÃO'}</span></td>
[4.186s] 12:             <td><span class="badge ${r.occluded ? 'badge-danger' : 'badge-ok'}">${r.occluded ? 'OCLUÍDO' : 'LIVRE'}</span></td>
