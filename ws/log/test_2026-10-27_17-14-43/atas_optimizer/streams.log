[4.002s] 12:     // Renderizador de Mapa 2D Town10 em Canvas
[4.002s] 12:     function drawMap(snap) {
[4.002s] 12:       const cvs = document.getElementById('map-canvas');
[4.002s] 12:       if (!cvs) return;
[4.002s] 12:       const ctx = cvs.getContext('2d');
[4.003s] 12:       const w = cvs.width = cvs.parentElement.clientWidth;
[4.003s] 12:       const h = cvs.height = cvs.parentElement.clientHeight;
[4.003s] 12: 
[4.003s] 12:       ctx.fillStyle = '#080c14';
[4.003s] 12:       ctx.fillRect(0, 0, w, h);
[4.003s] 12: 
[4.003s] 12:       // Centro em (0, 0)
[4.003s] 12:       const cx = w / 2;
[4.003s] 12:       const cy = h / 2;
[4.003s] 12:       const scale = 2.0; // pixels por metro
[4.003s] 12: 
[4.003s] 12:       // Grade
[4.004s] 12:       ctx.strokeStyle = '#1e293b';
[4.004s] 12:       ctx.lineWidth = 1;
[4.004s] 12:       for (let x = -200; x <= 200; x += 20) {
