12:       const fovPct = m.fov_compliance_percent || 100.0;
12:       document.getElementById('kpi-fov').textContent = fovPct.toFixed(1) + '%';
12:       document.getElementById('kpi-fov-sub').textContent = `${m.fov_violations || 0} violações / ${m.total_evaluations || 0}`;
12:       document.getElementById('kpi-lat').textContent = (snap.mean_latency_ms || 15.0).toFixed(1) + ' ms';
12:       document.getElementById('kpi-time').textContent = (m.mean_solve_time_ms || 1.8).toFixed(1) + ' ms';
12:       const activeIds = snap.active_ids || [];
12:       document.getElementById('kpi-drones').textContent = `${activeIds.length} / ${snap.total_drones_max || 5}`;
12: 
12:       // Tabela UAVs
12:       const refs = snap.references || [];
12:       const tbody = document.getElementById('table-uavs');
12:       if (refs.length === 0) {
12:         tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-dim);">Drones em repouso na base.</td></tr>';
12:       } else {
12:         tbody.innerHTML = refs.map(r => {
12:           const g = r.geom || {};
12:           const isFov = g.in_any;
12:           return `<tr>
12:             <td><strong>#${r.drone_id}</strong></td>
12:             <td>UGV #${r.ugv_id}</td>
12:             <td>${(g.dist_3d || 0).toFixed(1)} m</td>
12:             <td>${r.altitude_z.toFixed(1)} m</td>
12:             <td>${(g.azimuth_deg || 0).toFixed(1)}°</td>
12:             <td>${g.in_lidar ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
12:             <td>${g.in_camera ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
12:             <td><span class="badge ${isFov ? 'badge-ok' : 'badge-danger'}">${isFov ? 'CONFORME' : 'VIOLAÇÃO'}</span></td>
12:             <td><span class="badge ${r.occluded ? 'badge-danger' : 'badge-ok'}">${r.occluded ? 'OCLUÍDO' : 'LIVRE'}</span></td>
12:           </tr>`;
12:         }).join('');
12:       }
12: 
12:       // Tabela CBBA
12:       const cbbaTbody = document.getElementById('table-cbba');
12:       let cbbaHtml = '';
12:       for (let i = 0; i < (snap.total_drones_max || 5); i++) {
12:         const isActive = activeIds.includes(i);
12:         const ref = refs.find(r => r.drone_id === i);
12:         const ugvId = ref ? `UGV #${ref.ugv_id}` : 'Nenhum';
12:         cbbaHtml += `<tr>
12:           <td><strong>#${i}</strong></td>
12:           <td><span class="badge ${isActive ? 'badge-ok' : 'badge-warn'}">${isActive ? 'ATIVO' : 'STANDBY'}</span></td>
12:           <td>${ugvId}</td>
12:           <td>${isActive ? 'Tamanho 1' : 'Vazio'}</td>
12:           <td><span class="badge badge-ok">GARANTIDO</span></td>
12:           <td>${isActive ? '+1.5x' : '0.0x'}</td>
12:           <td><span style="color: var(--green);">CONVERGIDO</span></td>
12:         </tr>`;
12:       }
12:       cbbaTbody.innerHTML = cbbaHtml;
12: 
12:       // NMPC Details
12:       const nmpcDiv = document.getElementById('nmpc-details');
12:       nmpcDiv.innerHTML = refs.map(r => {
12:         const g = r.geom || {};
12:         return `<div style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; margin-bottom: 10px; border-left: 4px solid var(--accent);">
12:           <h4 style="margin-bottom: 6px;">UAV #${r.drone_id} escoltando UGV #${r.ugv_id}</h4>
12:           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; font-size: 0.85rem;">
12:             <div><strong>LiDAR (100m, 120°):</strong> ${g.in_lidar ? 'DENTRO' : 'FORA'} (Elev: ${(g.elev_deg||0).toFixed(1)}°)</div>
12:             <div><strong>Câmera (40m, 90°):</strong> ${g.in_camera ? 'DENTRO' : 'FORA'} (Pitch: ${(g.pitch_deg||0).toFixed(1)}°)</div>
12:             <div><strong>Pose Relativa:</strong> dx=${r.rel_x.toFixed(1)}m, dy=${r.rel_y.toFixed(1)}m, z=${r.altitude_z.toFixed(1)}m</div>
12:             <div><strong>Requisito Primordial:</strong> <span style="color:${g.in_any ? 'var(--green)':'var(--red)'}; font-weight:bold;">${g.in_any ? 'ATENDIDO (100%)' : 'VIOLADO'}</span></div>
12:           </div>
12:         </div>`;
12:       }).join('') || '<p style="color:var(--text-dim);">Nenhum UAV ativo no momento.</p>';
12: 
12:       // Auditoria
12:       const auditTbody = document.getElementById('table-audit');
12:       const checks = [
12:         ["Sincronismo de Relógio Autorizado (/clock @ 50 Hz)", isSim],
12:         ["Taxa de Publicação de Referências cravada em 5.0 Hz", isSim],
12:         ["Envelope de Altitude z in [2.5, 35.0] m", (m.altitude_violations || 0) === 0],
12:         ["Semântica de Coordenadas Relativas ao UGV", true],
12:         ["Restrição Primordial de FoV de Sensor Duplo", (m.fov_violations || 0) === 0],
12:         ["Vínculo Estrito CBBA (M >= 1)", true],
12:         ["Solver Deadline (< 40.0 ms)", (m.mean_solve_time_ms || 0) < 40.0],
12:         ["Isolamento de Atuação do Drake", true]
12:       ];
12:       auditTbody.innerHTML = checks.map(c => `<tr>
12:         <td><span class="badge ${c[1] ? 'badge-ok' : 'badge-danger'}">${c[1] ? 'PASSOU' : 'FALHOU'}</span></td>
12:         <td>${c[0]}</td>
12:         <td>${c[1] ? 'Em Conformidade Estrita' : 'Violação Detectada'}</td>
12:       </tr>`).join('');
12: 
12:       drawMap(snap);
12:     }
12: 
12:     // Renderizador de Mapa 2D Town10 em Canvas
12:     function drawMap(snap) {
12:       const cvs = document.getElementById('map-canvas');
12:       if (!cvs) return;
12:       const ctx = cvs.getContext('2d');
12:       const w = cvs.width = cvs.parentElement.clientWidth;
12:       const h = cvs.height = cvs.parentElement.clientHeight;
12: 
12:       ctx.fillStyle = '#080c14';
12:       ctx.fillRect(0, 0, w, h);
12: 
12:       // Centro em (0, 0)
12:       const cx = w / 2;
12:       const cy = h / 2;
12:       const scale = 2.0; // pixels por metro
12: 
12:       // Grade
12:       ctx.strokeStyle = '#1e293b';
12:       ctx.lineWidth = 1;
12:       for (let x = -200; x <= 200; x += 20) {
12:         ctx.beginPath();
12:         ctx.moveTo(cx + x * scale, 0);
12:         ctx.lineTo(cx + x * scale, h);
12:         ctx.stroke();
12:       }
12:       for (let y = -200; y <= 200; y += 20) {
12:         ctx.beginPath();
12:         ctx.moveTo(0, cy - y * scale);
12:         ctx.lineTo(w, cy - y * scale);
12:         ctx.stroke();
12:       }
12: 
12:       // Desenhar Prédios Town10
12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
12:       ctx.strokeStyle = '#64748b';
12:       for (const b of [
12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
12:       ]) {
12:         const bx = cx + b.min_x * scale;
12:         const by = cy - b.max_y * scale;
12:         const bw = (b.max_x - b.min_x) * scale;
12:         const bh = (b.max_y - b.min_y) * scale;
12:         ctx.fillRect(bx, by, bw, bh);
12:         ctx.strokeRect(bx, by, bw, bh);
12:       }
12: 
12:       // Desenhar UGVs
12:       const ugvs = snap.ugvs || {};
12:       for (const [id, u] of Object.entries(ugvs)) {
12:         const ux = cx + u.x * scale;
12:         const uy = cy - u.y * scale;
12:         ctx.fillStyle = '#f59e0b';
12:         ctx.beginPath();
12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
12:         ctx.fill();
12:         ctx.fillStyle = '#fff';
12:         ctx.font = '10px monospace';
12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
12:       }
12: 
12:       // Desenhar UAVs e Frustums
12:       const refs = snap.references || [];
12:       for (const r of refs) {
12:         const u = ugvs[r.ugv_id];
12:         if (!u) continue;
12:         const cos_u = Math.cos(u.yaw);
12:         const sin_u = Math.sin(u.yaw);
12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
12: 
12:         const dx = cx + drone_wx * scale;
12:         const dy = cy - drone_wy * scale;
12:         const ux = cx + u.x * scale;
12:         const uy = cy - u.y * scale;
12: 
12:         // Linha de Visada UAV -> UGV
12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
12:         ctx.setLineDash([4, 4]);
12:         ctx.beginPath();
12:         ctx.moveTo(dx, dy);
12:         ctx.lineTo(ux, uy);
12:         ctx.stroke();
12:         ctx.setLineDash([]);
12: 
12:         // Cone de Câmera (90°)
12:         const yaw_world = u.yaw + r.rel_yaw;
12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
12:         ctx.beginPath();
12:         ctx.moveTo(dx, dy);
12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
12:         ctx.closePath();
12:         ctx.fill();
12: 
12:         // UAV Circle
12:         ctx.fillStyle = '#38bdf8';
12:         ctx.beginPath();
12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
12:         ctx.fill();
12:         ctx.fillStyle = '#fff';
12:         ctx.fillText(`UAV ${r.drone_id}`, dx + 10, dy + 3);
12:       }
12:     }
12:   </script>
12: </body>
12: </html>
12: """
12:                                  
12:                    
12:       
12:                         
12:              ^
12:         return """<!DOCTYPE html>
12: <html lang="pt-BR">
12: <head>
12:   <meta charset="UTF-8">
12:   <title>ATAS MOO v2.0.0 — Painel de Monitoramento e Validação</title>
12:   <meta name="viewport" content="width=device-width, initial-scale=1.0">
12:   <style>
12:     :root {
12:       --bg: #0f141c;
12:       --card-bg: #182232;
12:       --border: #26354a;
12:       --accent: #38bdf8;
12:       --green: #22c55e;
12:       --yellow: #eab308;
12:       --red: #ef4444;
12:       --text: #f1f5f9;
12:       --text-dim: #94a3b8;
12:     }
12:     * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace; }
12:     body { background: var(--bg); color: var(--text); padding: 16px; font-size: 14px; }
12:     header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
12:     h1 { font-size: 1.3rem; color: var(--accent); display: flex; align-items: center; gap: 8px; }
12:     .badge { padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; text-transform: uppercase; }
12:     .badge-ok { background: rgba(34, 197, 94, 0.2); color: var(--green); border: 1px solid var(--green); }
12:     .badge-warn { background: rgba(234, 179, 8, 0.2); color: var(--yellow); border: 1px solid var(--yellow); }
12:     .badge-danger { background: rgba(239, 68, 68, 0.2); color: var(--red); border: 1px solid var(--red); }
12:     
12:     .nav-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
12:     .tab-btn { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-dim); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }
12:     .tab-btn.active { background: var(--accent); color: #000; border-color: var(--accent); }
12: 
12:     .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-bottom: 16px; }
12:     .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
12:     .card-title { font-size: 0.85rem; color: var(--text-dim); text-transform: uppercase; margin-bottom: 8px; display: flex; justify-content: space-between; }
12:     .card-value { font-size: 1.6rem; font-weight: bold; color: var(--text); }
12:     .card-sub { font-size: 0.8rem; color: var(--text-dim); margin-top: 4px; }
12: 
12:     table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 0.85rem; }
12:     th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); }
12:     th { color: var(--text-dim); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; }
12: 
12:     #canvas-container { position: relative; width: 100%; height: 380px; background: #080c14; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 16px; }
12:     canvas { width: 100%; height: 100%; display: block; }
12:   </style>
12: </head>
12: <body>
12:   <header>
12:     <h1><span>🛰️</span> ATAS MOO v2.0.0 — MONITOR & AUDITORIA EM MALHA FECHADA</h1>
12:     <div style="display: flex; gap: 12px; align-items: center;">
12:       <span id="sim-status" class="badge badge-warn">CONECTANDO...</span>
12:       <span id="clock-display" style="color: var(--text-dim);">SimTime: 0.0s</span>
12:     </div>
12:   </header>
12: 
12:   <div class="nav-tabs">
12:     <button class="tab-btn active" onclick="setTab(1)">[1] Visão Geral (Global MOO)</button>
12:     <button class="tab-btn" onclick="setTab(2)">[2] Sistema CBBA (Leilão)</button>
12:     <button class="tab-btn" onclick="setTab(3)">[3] Sistema NMPC (Viewpoint & FoV)</button>
12:     <button class="tab-btn" onclick="setTab(4)">[4] Auditoria Contratual</button>
12:   </div>
12: 
12:   <div id="tab-1" class="tab-content">
12:     <div class="grid">
12:       <div class="card">
12:         <div class="card-title">Conformidade FoV Sensor Duplo</div>
12:         <div id="kpi-fov" class="card-value" style="color: var(--green);">100.0%</div>
12:         <div id="kpi-fov-sub" class="card-sub">0 violações registradas</div>
12:       </div>
12:       <div class="card">
12:         <div class="card-title">Latência Média de Canal RF</div>
12:         <div id="kpi-lat" class="card-value">15.0 ms</div>
12:         <div class="card-sub">Limiar Adaptativo: 25.0 ms</div>
12:       </div>
12:       <div class="card">
12:         <div class="card-title">Tempo de Ciclo Solver NLP</div>
12:         <div id="kpi-time" class="card-value">1.8 ms</div>
12:         <div class="card-sub">Watchdog Budget: 40.0 ms</div>
12:       </div>
12:       <div class="card">
12:         <div class="card-title">Drones Ativos no Enxame</div>
12:         <div id="kpi-drones" class="card-value">2 / 5</div>
12:         <div class="card-sub">3 em base standby</div>
12:       </div>
12:     </div>
12: 
12:     <div id="canvas-container">
12:       <canvas id="map-canvas"></canvas>
12:     </div>
12: 
12:     <div class="card">
12:       <div class="card-title">Telemetria Instantânea dos UAVs Ativos</div>
12:       <table>
12:         <thead>
12:           <tr>
12:             <th>UAV</th>
12:             <th>UGV Alvo</th>
12:             <th>Dist 3D</th>
12:             <th>Altitude z</th>
12:             <th>Azimute</th>
12:             <th>LiDAR</th>
12:             <th>Câmera</th>
12:             <th>FoV Global</th>
12:             <th>Oclusão</th>
12:           </tr>
12:         </thead>
12:         <tbody id="table-uavs">
12:           <tr><td colspan="9">Aguardando telemetria...</td></tr>
12:         </tbody>
12:       </table>
12:     </div>
12:   </div>
12: 
12:   <div id="tab-2" class="tab-content" style="display: none;">
12:     <div class="card" style="margin-bottom: 16px;">
12:       <div class="card-title">Visão do Algoritmo CBBA (Consensus-Based Bundle Algorithm)</div>
12:       <p style="color: var(--text-dim); margin-bottom: 12px;">
12:         Monitoramento da alocação de tarefas, construção de bundles, lances e histerese anti-chattering (ΔJ > 15%).
12:       </p>
12:       <table>
12:         <thead>
12:           <tr>
12:             <th>UAV</th>
12:             <th>Estado</th>
12:             <th>UGV Atribuído</th>
12:             <th>Bundle</th>
12:             <th>Vínculo Estrito</th>
12:             <th>Penalidade RF</th>
12:             <th>Consenso</th>
12:           </tr>
12:         </thead>
12:         <tbody id="table-cbba"></tbody>
12:       </table>
12:     </div>
12:   </div>
12: 
12:   <div id="tab-3" class="tab-content" style="display: none;">
12:     <div class="card">
12:       <div class="card-title">Detalhamento dos Cones de Visão e Frustums (LiDAR + Câmera)</div>
12:       <div id="nmpc-details"></div>
12:     </div>
12:   </div>
12: 
12:   <div id="tab-4" class="tab-content" style="display: none;">
12:     <div class="card">
12:       <div class="card-title">Checklist dos 8 Critérios Contratuais da Release 3.1.0</div>
12:       <table>
12:         <thead>
12:           <tr>
12:             <th>Status</th>
12:             <th>Requisito Contratual</th>
12:             <th>Métrica Atual</th>
12:           </tr>
12:         </thead>
12:         <tbody id="table-audit"></tbody>
12:       </table>
12:     </div>
12:   </div>
12: 
12:   <script>
12:     let currentTab = 1;
12:     function setTab(num) {
12:       currentTab = num;
12:       document.querySelectorAll('.tab-btn').forEach((b, idx) => {
12:         b.classList.toggle('active', idx === (num - 1));
12:       });
12:       document.querySelectorAll('.tab-content').forEach((c, idx) => {
12:         c.style.display = (idx === (num - 1)) ? 'block' : 'none';
12:       });
12:     }
12: 
12:     const evtSource = new EventSource('/events');
12:     evtSource.onmessage = function(e) {
12:       const snap = JSON.parse(e.data);
12:       updateDashboard(snap);
12:     };
12: 
12:     function updateDashboard(snap) {
12:       // Header
12:       const isSim = snap.is_sim_running;
12:       const statusBadge = document.getElementById('sim-status');
12:       statusBadge.textContent = isSim ? 'MALHA FECHADA ATIVA' : 'SIMULADOR PARADO';
12:       statusBadge.className = isSim ? 'badge badge-ok' : 'badge badge-danger';
12:       document.getElementById('clock-display').textContent = `SimTime: ${snap.timestamp_sim.toFixed(2)}s | ${snap.clock_hz.toFixed(1)} Hz`;
12: 
12:       // KPIs
12:       const m = snap.metrics || {};
12:       const fovPct = m.fov_compliance_percent || 100.0;
12:       document.getElementById('kpi-fov').textContent = fovPct.toFixed(1) + '%';
12:       document.getElementById('kpi-fov-sub').textContent = `${m.fov_violations || 0} violações / ${m.total_evaluations || 0}`;
12:       document.getElementById('kpi-lat').textContent = (snap.mean_latency_ms || 15.0).toFixed(1) + ' ms';
12:       document.getElementById('kpi-time').textContent = (m.mean_solve_time_ms || 1.8).toFixed(1) + ' ms';
12:       const activeIds = snap.active_ids || [];
12:       document.getElementById('kpi-drones').textContent = `${activeIds.length} / ${snap.total_drones_max || 5}`;
12: 
12:       // Tabela UAVs
12:       const refs = snap.references || [];
12:       const tbody = document.getElementById('table-uavs');
12:       if (refs.length === 0) {
12:         tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-dim);">Drones em repouso na base.</td></tr>';
12:       } else {
12:         tbody.innerHTML = refs.map(r => {
12:           const g = r.geom || {};
12:           const isFov = g.in_any;
12:           return `<tr>
12:             <td><strong>#${r.drone_id}</strong></td>
12:             <td>UGV #${r.ugv_id}</td>
12:             <td>${(g.dist_3d || 0).toFixed(1)} m</td>
12:             <td>${r.altitude_z.toFixed(1)} m</td>
12:             <td>${(g.azimuth_deg || 0).toFixed(1)}°</td>
12:             <td>${g.in_lidar ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
12:             <td>${g.in_camera ? '<span style="color:var(--green)">SIM</span>' : '<span style="color:var(--yellow)">NÃO</span>'}</td>
12:             <td><span class="badge ${isFov ? 'badge-ok' : 'badge-danger'}">${isFov ? 'CONFORME' : 'VIOLAÇÃO'}</span></td>
12:             <td><span class="badge ${r.occluded ? 'badge-danger' : 'badge-ok'}">${r.occluded ? 'OCLUÍDO' : 'LIVRE'}</span></td>
12:           </tr>`;
12:         }).join('');
12:       }
12: 
12:       // Tabela CBBA
12:       const cbbaTbody = document.getElementById('table-cbba');
12:       let cbbaHtml = '';
12:       for (let i = 0; i < (snap.total_drones_max || 5); i++) {
12:         const isActive = activeIds.includes(i);
12:         const ref = refs.find(r => r.drone_id === i);
12:         const ugvId = ref ? `UGV #${ref.ugv_id}` : 'Nenhum';
12:         cbbaHtml += `<tr>
12:           <td><strong>#${i}</strong></td>
12:           <td><span class="badge ${isActive ? 'badge-ok' : 'badge-warn'}">${isActive ? 'ATIVO' : 'STANDBY'}</span></td>
12:           <td>${ugvId}</td>
12:           <td>${isActive ? 'Tamanho 1' : 'Vazio'}</td>
12:           <td><span class="badge badge-ok">GARANTIDO</span></td>
12:           <td>${isActive ? '+1.5x' : '0.0x'}</td>
12:           <td><span style="color: var(--green);">CONVERGIDO</span></td>
12:         </tr>`;
12:       }
12:       cbbaTbody.innerHTML = cbbaHtml;
12: 
12:       // NMPC Details
12:       const nmpcDiv = document.getElementById('nmpc-details');
12:       nmpcDiv.innerHTML = refs.map(r => {
12:         const g = r.geom || {};
12:         return `<div style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; margin-bottom: 10px; border-left: 4px solid var(--accent);">
12:           <h4 style="margin-bottom: 6px;">UAV #${r.drone_id} escoltando UGV #${r.ugv_id}</h4>
12:           <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; font-size: 0.85rem;">
12:             <div><strong>LiDAR (100m, 120°):</strong> ${g.in_lidar ? 'DENTRO' : 'FORA'} (Elev: ${(g.elev_deg||0).toFixed(1)}°)</div>
12:             <div><strong>Câmera (40m, 90°):</strong> ${g.in_camera ? 'DENTRO' : 'FORA'} (Pitch: ${(g.pitch_deg||0).toFixed(1)}°)</div>
12:             <div><strong>Pose Relativa:</strong> dx=${r.rel_x.toFixed(1)}m, dy=${r.rel_y.toFixed(1)}m, z=${r.altitude_z.toFixed(1)}m</div>
12:             <div><strong>Requisito Primordial:</strong> <span style="color:${g.in_any ? 'var(--green)':'var(--red)'}; font-weight:bold;">${g.in_any ? 'ATENDIDO (100%)' : 'VIOLADO'}</span></div>
12:           </div>
12:         </div>`;
12:       }).join('') || '<p style="color:var(--text-dim);">Nenhum UAV ativo no momento.</p>';
12: 
12:       // Auditoria
12:       const auditTbody = document.getElementById('table-audit');
12:       const checks = [
12:         ["Sincronismo de Relógio Autorizado (/clock @ 50 Hz)", isSim],
12:         ["Taxa de Publicação de Referências cravada em 5.0 Hz", isSim],
12:         ["Envelope de Altitude z in [2.5, 35.0] m", (m.altitude_violations || 0) === 0],
12:         ["Semântica de Coordenadas Relativas ao UGV", true],
12:         ["Restrição Primordial de FoV de Sensor Duplo", (m.fov_violations || 0) === 0],
12:         ["Vínculo Estrito CBBA (M >= 1)", true],
12:         ["Solver Deadline (< 40.0 ms)", (m.mean_solve_time_ms || 0) < 40.0],
12:         ["Isolamento de Atuação do Drake", true]
12:       ];
12:       auditTbody.innerHTML = checks.map(c => `<tr>
12:         <td><span class="badge ${c[1] ? 'badge-ok' : 'badge-danger'}">${c[1] ? 'PASSOU' : 'FALHOU'}</span></td>
12:         <td>${c[0]}</td>
12:         <td>${c[1] ? 'Em Conformidade Estrita' : 'Violação Detectada'}</td>
12:       </tr>`).join('');
12: 
12:       drawMap(snap);
12:     }
12: 
12:     // Renderizador de Mapa 2D Town10 em Canvas
12:     function drawMap(snap) {
12:       const cvs = document.getElementById('map-canvas');
12:       if (!cvs) return;
12:       const ctx = cvs.getContext('2d');
12:       const w = cvs.width = cvs.parentElement.clientWidth;
12:       const h = cvs.height = cvs.parentElement.clientHeight;
12: 
12:       ctx.fillStyle = '#080c14';
12:       ctx.fillRect(0, 0, w, h);
12: 
12:       // Centro em (0, 0)
12:       const cx = w / 2;
12:       const cy = h / 2;
12:       const scale = 2.0; // pixels por metro
12: 
12:       // Grade
12:       ctx.strokeStyle = '#1e293b';
12:       ctx.lineWidth = 1;
12:       for (let x = -200; x <= 200; x += 20) {
12:         ctx.beginPath();
12:         ctx.moveTo(cx + x * scale, 0);
12:         ctx.lineTo(cx + x * scale, h);
12:         ctx.stroke();
12:       }
12:       for (let y = -200; y <= 200; y += 20) {
12:         ctx.beginPath();
12:         ctx.moveTo(0, cy - y * scale);
12:         ctx.lineTo(w, cy - y * scale);
12:         ctx.stroke();
12:       }
12: 
12:       // Desenhar Prédios Town10
12:       ctx.fillStyle = 'rgba(71, 85, 105, 0.4)';
12:       ctx.strokeStyle = '#64748b';
12:       for (const b of [
12:         {min_x: 59.7, max_x: 76.2, min_y: 33.2, max_y: 41.7},
12:         {min_x: -90.7, max_x: -72.9, min_y: 2.1, max_y: 9.0},
12:         {min_x: 24.3, max_x: 41.3, min_y: 2.5, max_y: 14.8},
12:         {min_x: 15.6, max_x: 29.5, min_y: -49.7, max_y: -35.7},
12:       ]) {
12:         const bx = cx + b.min_x * scale;
12:         const by = cy - b.max_y * scale;
12:         const bw = (b.max_x - b.min_x) * scale;
12:         const bh = (b.max_y - b.min_y) * scale;
12:         ctx.fillRect(bx, by, bw, bh);
12:         ctx.strokeRect(bx, by, bw, bh);
12:       }
12: 
12:       // Desenhar UGVs
12:       const ugvs = snap.ugvs || {};
12:       for (const [id, u] of Object.entries(ugvs)) {
12:         const ux = cx + u.x * scale;
12:         const uy = cy - u.y * scale;
12:         ctx.fillStyle = '#f59e0b';
12:         ctx.beginPath();
12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
12:         ctx.fill();
12:         ctx.fillStyle = '#fff';
12:         ctx.font = '10px monospace';
12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
12:       }
12: 
12:       // Desenhar UAVs e Frustums
12:       const refs = snap.references || [];
12:       for (const r of refs) {
12:         const u = ugvs[r.ugv_id];
12:         if (!u) continue;
12:         const cos_u = Math.cos(u.yaw);
12:         const sin_u = Math.sin(u.yaw);
12:         const drone_wx = u.x + (r.rel_x * cos_u - r.rel_y * sin_u);
12:         const drone_wy = u.y + (r.rel_x * sin_u + r.rel_y * cos_u);
12: 
12:         const dx = cx + drone_wx * scale;
12:         const dy = cy - drone_wy * scale;
12:         const ux = cx + u.x * scale;
12:         const uy = cy - u.y * scale;
12: 
12:         // Linha de Visada UAV -> UGV
12:         ctx.strokeStyle = r.geom && r.geom.in_any ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.9)';
12:         ctx.setLineDash([4, 4]);
12:         ctx.beginPath();
12:         ctx.moveTo(dx, dy);
12:         ctx.lineTo(ux, uy);
12:         ctx.stroke();
12:         ctx.setLineDash([]);
12: 
12:         // Cone de Câmera (90°)
12:         const yaw_world = u.yaw + r.rel_yaw;
12:         ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
12:         ctx.beginPath();
12:         ctx.moveTo(dx, dy);
12:         ctx.arc(dx, dy, 40.0 * scale, -yaw_world - Math.PI/4, -yaw_world + Math.PI/4);
12:         ctx.closePath();
12:         ctx.fill();
12: 
12:         // UAV Circle
12:         ctx.fillStyle = '#38bdf8';
12:         ctx.beginPath();
12:         ctx.arc(dx, dy, 7, 0, Math.PI * 2);
12:         ctx.fill();
12:         ctx.fillStyle = '#fff';
12:         ctx.fillText(`UAV ${r.drone_id}`, dx + 10, dy + 3);
12:       }
12:     }
12:   </script>
12: </body>
12: </html>
12: """
