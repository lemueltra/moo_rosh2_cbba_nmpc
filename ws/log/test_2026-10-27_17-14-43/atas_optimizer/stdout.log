12:         const ux = cx + u.x * scale;
12:         const uy = cy - u.y * scale;
12:         ctx.fillStyle = '#f59e0b';
12:         ctx.beginPath();
12:         ctx.arc(ux, uy, 6, 0, Math.PI * 2);
12:         ctx.fill();
12:         ctx.fillStyle = '#fff';
12:         ctx.font = '10px monospace';
12:         ctx.fillText(`UGV ${id}`, ux + 8, uy + 3);
12:       }
