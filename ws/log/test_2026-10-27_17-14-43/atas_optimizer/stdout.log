12:     body { background: var(--bg); color: var(--text); padding: 16px; font-size: 14px; }
12:     header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
12:     h1 { font-size: 1.3rem; color: var(--accent); display: flex; align-items: center; gap: 8px; }
12:     .badge { padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; text-transform: uppercase; }
12:     .badge-ok { background: rgba(34, 197, 94, 0.2); color: var(--green); border: 1px solid var(--green); }
12:     .badge-warn { background: rgba(234, 179, 8, 0.2); color: var(--yellow); border: 1px solid var(--yellow); }
12:     .badge-danger { background: rgba(239, 68, 68, 0.2); color: var(--red); border: 1px solid var(--red); }
12:     
12:     .nav-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
12:     .tab-btn { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-dim); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }
