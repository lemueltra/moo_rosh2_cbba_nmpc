# .env - Configurações de Ambiente do Contêiner ATAS MOO
USER_UID=1000
USER_GID=1000
USERNAME=jonatas

ROS_DISTRO=jazzy
DRAKE_VERSION=1.57.0

# Domínio DDS compartilhado para comunicação nativa com o simulador Drake (Release 3.1.0)
SWARM_ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

MAX_DRONES=5

# Configurações de Interface Gráfica
DISPLAY=:0
WAYLAND_DISPLAY=wayland-0
XDG_RUNTIME_DIR=/run/user/1000

# Aceleração por Hardware GPU NVIDIA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display,video

# Compilação C++
CMAKE_BUILD_TYPE=Release
PARALLEL_JOBS=16
